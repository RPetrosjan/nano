{% extends 'base.html.twig' %}
{% block body %}
    <div class="blocknano">
        <div>
            <h1>{{ typeSection.title }}</h1>
            <div>
                <a href="{{ path('web_type_qcm', {'typeSection': typeSection.id}) }}" class="btn btn-info">Passer Test</a>
            </div>
            <div class="list-group list-group-flush">
                {% for documentations in typeSection.documentations %}
                    <a href="{{ path('web_type_documentation', {
                        'documentation': documentations.id
                    }) }}" class="list-group-item list-group-item-action">{{ documentations.title }}</a>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

